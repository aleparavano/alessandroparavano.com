---
import '../../styles/global.css';

const siteUrl = 'https://alessandroparavano.com';
const canonicalUrl = `${siteUrl}/media-contact/`;
const personId = `${siteUrl}/#person`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': personId,
  name: 'Alessandro Paravano',
  url: `${siteUrl}/`,
  jobTitle: 'Assistant Professor',
  email: 'mailto:alessandro.paravano@polimi.it',
  worksFor: {
    '@type': 'CollegeOrUniversity',
    name: 'Politecnico di Milano',
    url: 'https://www.polimi.it/'
  },
  sameAs: [
    'https://www.linkedin.com/in/alessandroparavano/',
    'https://twitter.com/AleParavano',
    'https://orcid.org/0000-0002-6884-3712',
    'https://scholar.google.com/citations?view_op=list_works&hl=it&user=ZLy7CJAAAAAJ',
    'https://re.public.polimi.it/cris/rp/rp111035'
  ],
  knowsAbout: [
    'Space Economy',
    'Earth Observation',
    'GNSS',
    'PNT',
    'Satellite communications',
    'Commercial space stations',
    'Low Earth Orbit economy',
    'In-space manufacturing',
    'Space project governance',
    'Business ecosystems',
    'Value networks',
    'Systems architecting',
    'Complex infrastructures'
  ]
};

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${canonicalUrl}#contact-page`,
  name: 'Media & Contact | Alessandro Paravano',
  url: canonicalUrl,
  description: 'Contact Alessandro Paravano for research collaborations, academic events, media enquiries, interviews and expert commentary on the Space Economy and complex infrastructures.',
  mainEntity: { '@id': personId }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Media & Contact', item: canonicalUrl }
  ]
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Media & Contact | Alessandro Paravano</title>
  <meta name="description" content="Contact Alessandro Paravano for research collaborations, media enquiries, interviews and academic events related to the Space Economy and complex infrastructures." />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Media & Contact | Alessandro Paravano" />
  <meta property="og:description" content="Research collaborations, media enquiries, interviews and academic events related to the Space Economy and complex infrastructures." />
  <meta property="og:url" content={canonicalUrl} />
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
</head>
<body>
  <header class="site-header">
    <nav class="container site-nav" aria-label="Primary navigation">
      <a class="brand" href="/">Alessandro Paravano</a>
      <div class="navlinks">
        <a href="/research/">Research</a>
        <a href="/publications/">Publications</a>
        <a href="/about/">About</a>
        <a href="/media-contact/" aria-current="page">Media &amp; Contact</a>
      </div>
    </nav>
  </header>

  <main class="media-v9-page">
    <section class="container media-v9-hero">
      <h1>Media &amp; Contact</h1>
      <p>For research collaborations, academic events, media enquiries, interviews or expert commentary, please get in touch.</p>
    </section>

    <section class="media-v9-section" aria-labelledby="contact-heading">
      <div class="container media-v9-layout">
        <div class="media-v9-heading">
          <h2 id="contact-heading">Contact</h2>
        </div>

        <div class="media-v9-contact-grid">
          <a class="media-v9-contact-card" href="mailto:alessandro.paravano@polimi.it">
            <span class="media-v9-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3.5" y="5.5" width="17" height="13" rx="1.5"></rect>
                <path d="M4.5 7l7.5 5.5L19.5 7"></path>
              </svg>
            </span>
            <span class="media-v9-contact-copy">
              <strong>Email</strong>
              <span>alessandro.paravano@polimi.it</span>
            </span>
            <span class="media-v9-arrow" aria-hidden="true">↗</span>
          </a>

          <a class="media-v9-contact-card" href="https://www.linkedin.com/in/alessandroparavano/" target="_blank" rel="me noopener">
            <span class="media-v9-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                <path d="M8 10v6"></path>
                <path d="M8 7.5v.1"></path>
                <path d="M11.5 16v-3.25c0-1.65.95-2.65 2.35-2.65 1.45 0 2.15.95 2.15 2.65V16"></path>
                <path d="M11.5 10.25V16"></path>
              </svg>
            </span>
            <span class="media-v9-contact-copy">
              <strong>LinkedIn</strong>
              <span>Professional profile</span>
            </span>
            <span class="media-v9-arrow" aria-hidden="true">↗</span>
          </a>

          <a class="media-v9-contact-card" href="https://twitter.com/AleParavano" target="_blank" rel="me noopener">
            <span class="media-v9-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5.5 4.5l13 15"></path>
                <path d="M18.5 4.5l-13 15"></path>
              </svg>
            </span>
            <span class="media-v9-contact-copy">
              <strong>X / Twitter</strong>
              <span>@AleParavano</span>
            </span>
            <span class="media-v9-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="media-v9-section media-v9-section--outreach" aria-labelledby="outreach-heading">
      <div class="container media-v9-layout">
        <div class="media-v9-heading">
          <h2 id="outreach-heading">Selected media &amp; outreach</h2>
        </div>

        <div class="media-v9-outreach-grid">
          <article class="media-v9-outreach-item">
            <p class="media-v9-meta">Talk <span>·</span> Space Economy Observatory <span>·</span> March 2025</p>
            <h3><a href="https://www.osservatori.net/convegno/space-economy/dei-risultati-ricerca-osservatorio-space-economy/" target="_blank" rel="noopener">Presentazione risultati indagine filiera spazio</a></h3>
            <p class="media-v9-topics">Italian Space Economy · industrial value chain · market evolution</p>
          </article>

          <article class="media-v9-outreach-item">
            <p class="media-v9-meta">Event <span>·</span> BIP InSummit <span>·</span> October 2025</p>
            <h3><a href="https://www.in-summit.com/events/lo-spazio-come-ecosistema-di-innovazione-multidisciplinare" target="_blank" rel="noopener">Lo spazio come ecosistema di innovazione multidisciplinare</a></h3>
            <p class="media-v9-topics">Space ecosystems · multidisciplinary innovation · cross-sector applications</p>
          </article>

          <article class="media-v9-outreach-item">
            <p class="media-v9-meta">Article <span>·</span> Osservatori.net <span>·</span> March 2023</p>
            <h3><a href="https://www.osservatori.net/insight/space-economy/ruolo-space-economy-sfide-sanitarie-insight/" target="_blank" rel="noopener">Il ruolo della Space Economy nell’affrontare le sfide sanitarie contemporanee</a></h3>
            <p class="media-v9-topics">Space Economy · healthcare · satellite applications</p>
          </article>

          <article class="media-v9-outreach-item">
            <p class="media-v9-meta">Article <span>·</span> Osservatori.net <span>·</span> February 2023</p>
            <h3><a href="https://www.osservatori.net/insight/space-economy/infrastrutture-abilitanti-innovazione-digitale-internet-satellitare-insight/" target="_blank" rel="noopener">Infrastrutture abilitanti per l’Innovazione Digitale: l’Internet Satellitare</a></h3>
            <p class="media-v9-topics">Satellite communications · digital infrastructure · connectivity</p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-top">
      <div class="footer-identity">
        <strong>Alessandro Paravano</strong>
        <span>Assistant Professor, Politecnico di Milano</span>
        <a href="mailto:alessandro.paravano@polimi.it">alessandro.paravano@polimi.it</a>
      </div>
      <div class="footer-explore">
        <span class="footer-label">Navigation</span>
        <a href="/research/">Research</a> · <a href="/publications/">Publications</a> · <a href="/about/">About</a> · <a href="/media-contact/">Media &amp; Contact</a>
      </div>
    </div>

    <div class="container footer-profiles">
      <span class="footer-label profiles-label">Profiles</span>
      <div class="profiles-grid">
        <div>
          <h3>Institutional</h3>
          <a href="https://www.dig.polimi.it/en/staff/alessandro.paravano" target="_blank" rel="me noopener">Politecnico di Milano, DIG</a>
          <a href="https://www.som.polimi.it/en/faculty/paravano-alessandro/" target="_blank" rel="me noopener">POLIMI School of Management</a>
          <a href="https://re.public.polimi.it/cris/rp/rp111035" target="_blank" rel="me noopener">RE.PUBLIC@POLIMI</a>
        </div>
        <div>
          <h3>Academic profiles</h3>
          <a href="https://scholar.google.com/citations?view_op=list_works&hl=it&user=ZLy7CJAAAAAJ" target="_blank" rel="me noopener">Google Scholar</a>
          <a href="https://orcid.org/0000-0002-6884-3712" target="_blank" rel="me noopener">ORCID</a>
          <a href="https://openalex.org/authors/A5004512386" target="_blank" rel="me noopener">OpenAlex</a>
          <a href="https://www.webofscience.com/wos/author/record/KUC-6564-2024" target="_blank" rel="me noopener">Web of Science</a>
        </div>
        <div class="profiles-continuation">
          <h3>Academic profiles continued</h3>
          <a href="https://www.scopus.com/inward/authorDetails.url?authorID=58242859800&partnerID=MN8TOARS" target="_blank" rel="me noopener">Scopus</a>
          <a href="https://authors.repec.org/pro/ppa1688/" target="_blank" rel="me noopener">RePEc</a>
          <a href="https://papers.ssrn.com/sol3/cf_dev/AbsByAuth.cfm?per_id=7685061" target="_blank" rel="me noopener">SSRN</a>
          <a href="https://www.researchgate.net/profile/Alessandro-Paravano" target="_blank" rel="me noopener">ResearchGate</a>
        </div>
        <div>
          <h3>Professional</h3>
          <a href="https://www.linkedin.com/in/alessandroparavano/" target="_blank" rel="me noopener">LinkedIn</a>
          <a href="https://twitter.com/AleParavano" target="_blank" rel="me noopener">X / Twitter</a>
        </div>
      </div>
    </div>

    <div class="container footer-bottom">© {new Date().getFullYear()} Alessandro Paravano</div>
  </footer>
</body>
</html>
