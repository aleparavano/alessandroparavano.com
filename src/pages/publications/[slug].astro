---
import '../../styles/global.css';
import { publications, getDetailedPublications } from './publications.js';

export function getStaticPaths() {
  return getDetailedPublications().map((publication) => ({
    params: { slug: publication.slug },
    props: { publication }
  }));
}

const { publication } = Astro.props;
const siteUrl = 'https://alessandroparavano.com';
const canonicalUrl = `${siteUrl}/publications/${publication.slug}/`;
const doiUrl = publication.doi ? `https://doi.org/${publication.doi}` : null;
const typeLabels = {
  journal: 'Journal article',
  chapter: 'Book chapter',
  report: 'Report',
  book: 'Book',
  editorial: 'Editorial'
};
const typeLabel = publication.typeLabel || typeLabels[publication.type] || 'Publication';
const schemaType = publication.schemaType || 'ScholarlyArticle';
const relatedPublications = (publication.related || [])
  .map((slug) => publications.find((item) => item.slug === slug))
  .filter(Boolean);
const findings = (publication.findings || []).map((finding) =>
  typeof finding === 'string'
    ? { title: null, text: finding }
    : finding
);
const whyItMatters = Array.isArray(publication.whyItMatters)
  ? publication.whyItMatters
  : publication.whyItMatters
    ? [publication.whyItMatters]
    : [];
const allKeywords = [...new Set([
  ...(publication.officialKeywords || []),
  ...(publication.themes || []),
  ...(publication.metadataTopics || [])
])];
const schemaAbout = [...new Set(publication.metadataAbout || publication.themes || [])];
const schemaMentions = [...new Set(publication.metadataMentions || [])];
const personId = `${siteUrl}/#person`;
const articleId = `${canonicalUrl}#article`;

const scholarlySchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  '@id': articleId,
  headline: publication.title,
  name: publication.title,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  datePublished: publication.publicationDate || String(publication.year),
  description: publication.seoDescription || publication.about,
  abstract: publication.about,
  author: publication.authors.map((name) => (
    name === 'Alessandro Paravano'
      ? { '@type': 'Person', '@id': personId, name }
      : { '@type': 'Person', name }
  )),
  isPartOf: {
    '@type': publication.type === 'journal' ? 'Periodical' : 'CreativeWork',
    name: publication.venue,
    issn: publication.issn || undefined
  },
  volumeNumber: publication.volume || undefined,
  pageStart: publication.firstPage || undefined,
  pageEnd: publication.lastPage || undefined,
  publisher: publication.publisherName ? { '@type': 'Organization', name: publication.publisherName } : undefined,
  identifier: publication.doi ? { '@type': 'PropertyValue', propertyID: 'DOI', value: publication.doi } : undefined,
  keywords: allKeywords,
  about: schemaAbout.map((name) => ({ '@type': 'Thing', name })),
  mentions: schemaMentions.map((name) => ({ '@type': 'Thing', name })),
  spatialCoverage: publication.spatialCoverage ? { '@type': 'Place', name: publication.spatialCoverage } : undefined,
  inLanguage: publication.language || 'en',
  genre: publication.genre || typeLabel,
  isAccessibleForFree: publication.repositoryLabel === 'Open access' ? true : undefined,
  sameAs: [doiUrl, publication.publisherUrl, publication.repositoryUrl].filter(Boolean),
  isRelatedTo: relatedPublications.map((item) => ({
    '@type': 'ScholarlyArticle',
    name: item.title,
    url: item.fullPage ? `${siteUrl}/publications/${item.slug}/` : item.doi ? `https://doi.org/${item.doi}` : undefined
  }))
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': personId,
  name: 'Alessandro Paravano',
  url: `${siteUrl}/`,
  affiliation: {
    '@type': 'Organization',
    name: 'Politecnico di Milano',
    url: 'https://www.polimi.it/'
  },
  sameAs: [
    'https://orcid.org/0000-0002-6884-3712',
    'https://scholar.google.com/citations?view_op=list_works&hl=it&user=ZLy7CJAAAAAJ',
    'https://re.public.polimi.it/cris/rp/rp111035',
    'https://openalex.org/authors/A5004512386',
    'https://www.semanticscholar.org/author/Alessandro-Paravano/2216457586',
    'https://www.linkedin.com/in/aparavano/'
  ]
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Publications', item: `${siteUrl}/publications/` },
    { '@type': 'ListItem', position: 3, name: publication.title, item: canonicalUrl }
  ]
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{publication.title} | Alessandro Paravano</title>
  <meta name="description" content={publication.seoDescription || publication.takeaway || publication.about} />
  <link rel="canonical" href={canonicalUrl} />

  <meta name="citation_title" content={publication.title} />
  {publication.authors.map((author) => <meta name="citation_author" content={author} />)}
  <meta name="citation_publication_date" content={publication.publicationDate || String(publication.year)} />
  {(publication.type === 'journal' || publication.type === 'editorial') && <meta name="citation_journal_title" content={publication.venue} />}
  {publication.type === 'chapter' && <meta name="citation_book_title" content={publication.venue} />}
  {publication.issn && <meta name="citation_issn" content={publication.issn} />}
  {publication.volume && <meta name="citation_volume" content={publication.volume} />}
  {publication.firstPage && <meta name="citation_firstpage" content={publication.firstPage} />}
  {publication.lastPage && <meta name="citation_lastpage" content={publication.lastPage} />}
  {publication.doi && <meta name="citation_doi" content={publication.doi} />}
  <meta name="citation_language" content={publication.language || 'en'} />
  <meta name="citation_abstract_html_url" content={canonicalUrl} />
  {publication.publisherName && <meta name="citation_publisher" content={publication.publisherName} />}

  <meta property="og:type" content="article" />
  <meta property="og:title" content={publication.title} />
  <meta property="og:description" content={publication.seoDescription || publication.takeaway || publication.about} />
  <meta property="og:url" content={canonicalUrl} />
  {publication.publicationDate && <meta property="article:published_time" content={publication.publicationDate} />}

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(scholarlySchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
</head>
<body>
  <header class="site-header">
    <nav class="container site-nav" aria-label="Primary navigation">
      <a class="brand" href="/">Alessandro Paravano</a>
      <div class="navlinks">
        <a href="/research/">Research</a>
        <a href="/publications/" aria-current="page">Publications</a>
        <a href="/about/">About</a>
        <a href="/media-contact/">Media &amp; Contact</a>
      </div>
    </nav>
  </header>

  <main class="publication-detail-page">
    <section class="container publication-detail-hero">
      <a class="publication-back" href="/publications/">← All publications</a>

      <div class="publication-hero-main">
        <p class="publication-type-label">{typeLabel} <span aria-hidden="true">·</span> {publication.year}</p>
        <h1>{publication.title}</h1>
        <p class="publication-detail-authors">
          {publication.authors.map((author, index) => (
            <>
              {author === 'Alessandro Paravano' ? <strong>{author}</strong> : author}
              {index < publication.authors.length - 1 ? ', ' : ''}
            </>
          ))}
        </p>
        <p class="publication-detail-venue"><em>{publication.venue}</em>{publication.details ? <> <span aria-hidden="true">·</span> {publication.details}</> : ''}</p>
        <div class="publication-access-links" aria-label="Publication links">
          {doiUrl && <a href={doiUrl} target="_blank" rel="noopener">DOI <span aria-hidden="true">↗</span></a>}
          {publication.publisherUrl && <a href={publication.publisherUrl} target="_blank" rel="noopener">Publisher <span aria-hidden="true">↗</span></a>}
          {publication.repositoryUrl && <a href={publication.repositoryUrl} target="_blank" rel="noopener">{publication.repositoryLabel || 'Repository'} <span aria-hidden="true">↗</span></a>}
        </div>
      </div>

      {publication.takeaway && (
        <div class="publication-takeaway-block">
          <span>Core insight</span>
          <p>{publication.takeaway}</p>
        </div>
      )}
    </section>

    <section class="container publication-detail-section" aria-labelledby="about-research-heading">
      <div class="publication-detail-heading">
        <h2 id="about-research-heading">Content</h2>
      </div>
      <div class="publication-detail-content publication-prose">
        <p>{publication.about}</p>
      </div>
    </section>

    {publication.researchQuestions?.length > 0 && (
      <section class="container publication-detail-section" aria-labelledby="research-question-heading">
        <div class="publication-detail-heading">
          <h2 id="research-question-heading">Research questions</h2>
        </div>
        <div class="publication-detail-content research-question-grid">
          {publication.researchQuestions.map((question, index) => (
            <div class="research-question-item">
              <span>RQ{index + 1}</span>
              <p>{question}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {publication.approach && (
      <section class="container publication-detail-section" aria-labelledby="approach-heading">
        <div class="publication-detail-heading">
          <h2 id="approach-heading">Method</h2>
        </div>
        <div class="publication-detail-content publication-prose">
          <p>{publication.approach}</p>
          {publication.facts?.length > 0 && (
            <dl class="publication-facts" aria-label="Research snapshot">
              {publication.facts.map((fact) => (
                <div>
                  <dt>{fact.value}</dt>
                  <dd>{fact.label}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </section>
    )}

    {findings.length > 0 && (
      <section class="container publication-detail-section" aria-labelledby="findings-heading">
        <div class="publication-detail-heading">
          <h2 id="findings-heading">Key findings</h2>
        </div>
        <div class="publication-detail-content key-findings-editorial">
          {findings.map((finding) => (
            <article class="key-finding-item">
              {finding.title && <h3>{finding.title}</h3>}
              <p>{finding.text}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {whyItMatters.length > 0 && (
      <section class="container publication-detail-section" aria-labelledby="why-matters-heading">
        <div class="publication-detail-heading">
          <h2 id="why-matters-heading">Why it matters</h2>
        </div>
        <div class="publication-detail-content publication-prose publication-prose-stack">
          {whyItMatters.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>
    )}

    {relatedPublications.length > 0 && (
      <section class="container publication-detail-section" aria-labelledby="related-heading">
        <div class="publication-detail-heading">
          <h2 id="related-heading">Related research</h2>
        </div>
        <div class="publication-detail-content related-publications-list">
          {relatedPublications.map((item) => {
            const targetUrl = item.fullPage ? `/publications/${item.slug}/` : item.doi ? `https://doi.org/${item.doi}` : item.publisherUrl;
            return (
              <article class="related-publication">
                <div>
                  <h3><a href={targetUrl} target={item.fullPage ? undefined : '_blank'} rel={item.fullPage ? undefined : 'noopener'}>{item.title}</a></h3>
                  <p>{item.venue} <span aria-hidden="true">·</span> {item.year}</p>
                </div>
                <a class="related-publication-action" href={targetUrl} target={item.fullPage ? undefined : '_blank'} rel={item.fullPage ? undefined : 'noopener'}>
                  {item.fullPage ? 'Explore research' : 'View publication'} <span aria-hidden="true">↗</span>
                </a>
              </article>
            );
          })}
        </div>
      </section>
    )}

    {publication.citation && (
      <section class="container publication-detail-section publication-citation-section" aria-labelledby="citation-heading">
        <div class="publication-detail-heading">
          <h2 id="citation-heading">Citation</h2>
        </div>
        <div class="publication-detail-content">
          <p class="publication-citation">{publication.citation}</p>
          <div class="citation-export" aria-label="Download citation">
            <span class="citation-export-label">Export citation</span>
            <div class="citation-export-actions">
              <a class="citation-download-button" href={`/publications/${publication.slug}.ris`} download>RIS <span class="citation-button-note">Zotero, EndNote</span></a>
              <a class="citation-download-button citation-download-button--secondary" href={`/publications/${publication.slug}.bib`} download>BibTeX <span class="citation-button-note">LaTeX, reference managers</span></a>
            </div>
          </div>
          <div class="publication-detail-links publication-detail-links--bottom">
            {doiUrl && <a href={doiUrl} target="_blank" rel="noopener">DOI <span aria-hidden="true">↗</span></a>}
            {publication.publisherUrl && <a href={publication.publisherUrl} target="_blank" rel="noopener">Publisher <span aria-hidden="true">↗</span></a>}
            {publication.repositoryUrl && <a href={publication.repositoryUrl} target="_blank" rel="noopener">{publication.repositoryLabel || 'Repository'} <span aria-hidden="true">↗</span></a>}
          </div>
          <a class="publication-return-link" href="/publications/">← Back to all publications</a>
        </div>
      </section>
    )}
  </main>

  <footer class="site-footer">
    <div class="container footer-top">
      <div class="footer-identity">
        <strong>Alessandro Paravano</strong>
        <span>Assistant Professor, Politecnico di Milano</span>
        <a href="mailto:alessandro.paravano@polimi.it">alessandro.paravano@polimi.it</a>
      </div>
      <div class="footer-explore">
        <span class="footer-label">Navigation</span>
        <a href="/research/">Research</a> · <a href="/publications/">Publications</a> · <a href="/about/">About</a> · <a href="/media-contact/">Media &amp; Contact</a>
      </div>
    </div>

    <div class="container footer-profiles">
      <span class="footer-label profiles-label">Profiles</span>
      <div class="profiles-grid">
        <div>
          <h3>Institutional</h3>
          <a href="https://www.dig.polimi.it/en/staff/alessandro.paravano" target="_blank" rel="me noopener">Politecnico di Milano, DIG</a>
          <a href="https://www.som.polimi.it/en/faculty/paravano-alessandro/" target="_blank" rel="me noopener">Politecnico di Milano, School of Management</a>
          <a href="https://onlineservices.polimi.it/manifesti/manifesti/controller/ricerche/RicercaPerDocentiPublic.do?EVN_PRODOTTI=evento&k_doc=457597&lang=EN&aa=2026&tab_ricerca=1" target="_blank" rel="me noopener">Politecnico di Milano, University Profile</a>
          <a href="https://re.public.polimi.it/cris/rp/rp111035" target="_blank" rel="me noopener">RE.PUBLIC@POLIMI</a>
        </div>
        <div>
          <h3>Academic profiles</h3>
          <a href="https://scholar.google.com/citations?view_op=list_works&hl=it&user=ZLy7CJAAAAAJ" target="_blank" rel="me noopener">Google Scholar</a>
          <a href="https://orcid.org/0000-0002-6884-3712" target="_blank" rel="me noopener">ORCID</a>
          <a href="https://www.semanticscholar.org/author/Alessandro-Paravano/2216457586" target="_blank" rel="me noopener">Semantic Scholar</a>
          <a href="https://openalex.org/authors/A5004512386" target="_blank" rel="me noopener">OpenAlex</a>
          <a href="https://www.webofscience.com/wos/author/record/KUC-6564-2024" target="_blank" rel="me noopener">Web of Science</a>
        </div>
        <div class="profiles-continuation">
          <h3>Academic profiles continued</h3>
          <a href="https://www.scopus.com/inward/authorDetails.url?authorID=58242859800&partnerID=MN8TOARS" target="_blank" rel="me noopener">Scopus</a>
          <a href="https://authors.repec.org/pro/ppa1688/" target="_blank" rel="me noopener">RePEc</a>
          <a href="https://papers.ssrn.com/sol3/cf_dev/AbsByAuth.cfm?per_id=7685061" target="_blank" rel="me noopener">SSRN</a>
          <a href="https://www.researchgate.net/profile/Alessandro-Paravano" target="_blank" rel="me noopener">ResearchGate</a>
          <a href="https://researchid.co/alessandroparavano" target="_blank" rel="me noopener">ResearchID.co</a>
        </div>
        <div>
          <h3>Professional</h3>
          <a href="https://www.linkedin.com/in/aparavano/" target="_blank" rel="me noopener">LinkedIn</a>
          <a href="https://twitter.com/AleParavano" target="_blank" rel="me noopener">X / Twitter</a>
        </div>
      </div>
    </div>

    <div class="container footer-bottom">© {new Date().getFullYear()} Alessandro Paravano</div>
  </footer>
</body>
</html>
