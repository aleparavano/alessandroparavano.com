  },
  knowsAbout: [
    'Space Economy',
    'Complex infrastructures',
    'Earth Observation',
    'GNSS and PNT',
    'Satellite communications',
    'Commercial space stations',
    'Low Earth Orbit economy',
    'Space project governance',
    'Business ecosystems',
    'Project ecologies',
    'Value networks',
    'Systems architecting',
    'Project management',
    'Infrastructure governance'
  ],
  award: [
    'Fulbright scholarship, 2026',
    'SGAC-OHB SE Competition award on commercial space stations, 2025',
    'PMI Young Researcher Award, 2024'
  ],
  sameAs: [
    'https://orcid.org/0000-0002-6884-3712',
    'https://scholar.google.com/citations?view_op=list_works&hl=it&user=ZLy7CJAAAAAJ',
    'https://www.dig.polimi.it/en/staff/alessandro.paravano',
    'https://www.som.polimi.it/en/faculty/paravano-alessandro/',
    'https://re.public.polimi.it/cris/rp/rp111035',
    'https://openalex.org/authors/A5004512386',
    'https://www.semanticscholar.org/author/Alessandro-Paravano/2216457586',
    'https://www.webofscience.com/wos/author/record/KUC-6564-2024',
    'https://www.scopus.com/inward/authorDetails.url?authorID=58242859800&partnerID=MN8TOARS',
