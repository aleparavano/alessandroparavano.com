const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${canonicalUrl}#profile-page`,
  name: 'About Alessandro Paravano',
  url: canonicalUrl,
  description: 'Academic profile of Alessandro Paravano, Assistant Professor at Politecnico di Milano researching the Space Economy, complex infrastructures, value networks, systems architecting and project governance.',
  mainEntity: { '@id': personId }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'About', item: canonicalUrl }
