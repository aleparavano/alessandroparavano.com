  <script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
</head>
<body>
  <header class="site-header">
    <nav class="container site-nav" aria-label="Primary navigation">
      <a class="brand" href="/">Alessandro Paravano</a>
      <div class="navlinks">
        <a href="/research/">Research</a>
        <a href="/publications/">Publications</a>
        <a href="/about/" aria-current="page">About</a>
        <a href="/media-contact/">Media &amp; Contact</a>
      </div>
    </nav>
  </header>

  <main class="about-page about-page-v2">
    <section class="container about-v2-hero">
      <p class="about-v2-eyebrow">About</p>
      <div class="about-v2-hero-grid">
        <div>
          <h1>Academic profile</h1>
          <p class="about-v2-role">Alessandro Paravano, PhD</p>
        </div>
        <div class="about-v2-hero-intro">
          <p><strong>Alessandro Paravano</strong> is an Assistant Professor at Politecnico di Milano and a researcher in the Space Economy Observatory. This page summarizes his academic appointments, teaching, honors and awards, editorial service, conference contributions and scientific affiliations.</p>
          <div class="about-v2-profile-links" aria-label="Academic profiles">
            <a href="https://www.som.polimi.it/en/faculty/paravano-alessandro/" target="_blank" rel="me noopener">POLIMI</a>
            <a href="https://scholar.google.com/citations?view_op=list_works&hl=it&user=ZLy7CJAAAAAJ" target="_blank" rel="me noopener">Google Scholar</a>
            <a href="https://orcid.org/0000-0002-6884-3712" target="_blank" rel="me noopener">ORCID</a>
            <a href="https://re.public.polimi.it/cris/rp/rp111035" target="_blank" rel="me noopener">RE.PUBLIC@POLIMI</a>
          </div>
        </div>
      </div>
      <nav class="about-v2-local-nav" aria-label="About page sections">
        <a href="#bio">Bio</a><a href="#position">Current position</a><a href="#teaching">Teaching</a><a href="#awards">Honors &amp; awards</a><a href="#journals">Journals</a><a href="#conferences">Conferences</a><a href="#associations">Associations</a>
      </nav>
    </section>

    <section id="bio" class="about-v2-section">
      <div class="container about-v2-grid">
        <div class="about-v2-heading"><h2>Bio</h2></div>
        <div class="about-v2-content about-v2-prose">
          <p><strong>Alessandro Paravano</strong> is an Assistant Professor and Core Faculty member at the POLIMI School of Management, Politecnico di Milano, and a senior researcher with the Space Economy Observatory. His primary empirical domain is the <strong>Space Economy</strong>. He studies how new technologies, private actors, markets and governance arrangements reshape industrial value chains, business ecosystems and the relationship between space infrastructure and end users.</p>
          <p>His research connects strategic project management, systems engineering and systems architecting to examine value and value networks, business ecosystems and project ecologies, project governance, commercialization, resilience and long-term project success. Empirical areas include Earth Observation, GNSS and PNT, satellite communications, launchers, Commercial Space Stations, the LEO economy, in-space manufacturing and other complex infrastructures. He combines qualitative and quantitative methods and holds a PhD and MSc in Management Engineering from Politecnico di Milano with highest honours.</p>
        </div>
      </div>
    </section>

    <section id="position" class="about-v2-section about-v2-section-soft">
