  { year: '2026', title: 'Horizon Europe MSCA Seal of Excellence', org: 'European Commission, Marie Skłodowska-Curie Actions', href: 'https://marie-sklodowska-curie-actions.ec.europa.eu/whats-new/news/msca-seal-of-excellence-awarded-to-9847-outstanding-postdoctoral-researchers', source: 'European Commission' },
