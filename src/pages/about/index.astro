            <strong aria-hidden="true">→</strong>
          </a>
          <a href="/publications/">
            <span>Publications</span>
            <p>Peer-reviewed research, chapters, reports and conference outputs.</p>
            <strong aria-hidden="true">→</strong>
          </a>
          <a href="/media-contact/">
            <span>Media &amp; Contact</span>
            <p>Research collaborations, expert commentary, interviews and events.</p>
            <strong aria-hidden="true">→</strong>
          </a>
        </div>
      </div>
    </section>
